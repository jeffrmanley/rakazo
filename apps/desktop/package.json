{
  "name": "@rakazo/desktop",
  "productName": "withJZ Crew",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "pack": "pnpm build && electron-builder --win",
    "pack:dir": "pnpm build && electron-builder --dir",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/desktop/src",
    "test:e2e": "pnpm build && playwright test --config e2e/playwright.config.ts",
    "release": "pnpm build && electron-builder --publish never",
    "pack:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "icons": "node scripts/brand-icons.mjs"
  },
  "dependencies": {
    "@rakazo/contracts": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@rakazo/ui-tokens": "workspace:*",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "build": {
    "appId": "com.withjz.crew.desktop",
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../FORK_CHANGES.md",
        "to": "FORK_CHANGES.md"
      }
    ],
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "mac": {
      "icon": "assets/icon-macos.png",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "notarize": true
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "legalTrademarks": "withJZ Crew",
      "signAndEditExecutable": true
    },
    "linux": {
      "executableName": "withjz-crew",
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "publish": null,
    "copyright": "withJZ LLC. Based on Rakazo (Apache-2.0).",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "withJZ Crew",
      "uninstallDisplayName": "withJZ Crew",
      "artifactName": "withJZ-Crew-Setup-${version}.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "description": "withJZ Crew desktop app (fork of Rakazo)",
  "author": "withJZ LLC"
}
